<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 冷启动主题：只显示 splash_bg，window 背景即闪屏 -->
    <style name="Theme.LxVideo.Splash" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@drawable/splash_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!-- 主主题：onCreate 里 setTheme 切过来，深色视频 UI -->
    <style name="Theme.LxVideo.Main" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
